<config xmlns="urn:org:jgroups"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="urn:org:jgroups http://www.jgroups.org/schema/jgroups-5.5.xsd">
    <!--
    In-JVM stack for the JGroupsClusterManager tests: SHARED_LOOPBACK moves messages through a static per-JVM
    registry, so no port is bound and nothing escapes the machine. Failure detection and merging are tuned far
    more aggressively than the shipped stacks so that node-departure and split-brain tests finish in seconds.
    -->
    <SHARED_LOOPBACK/>
    <SHARED_LOOPBACK_PING/>
    <MERGE3 min_interval="1000" max_interval="3000"/>
    <FD_ALL3 interval="500" timeout="2000"/>
    <VERIFY_SUSPECT2 timeout="500"/>
    <pbcast.NAKACK2 use_mcast_xmit="false" xmit_interval="200"/>
    <UNICAST3 xmit_interval="200"/>
    <pbcast.STABLE desired_avg_gossip="5000" max_bytes="1M"/>
    <pbcast.GMS print_local_addr="false" join_timeout="1000"/>
    <FRAG4 frag_size="60K"/>
</config>
